micronaut {
  application { name = "pkl-aot" }
  server {
    port = 8080
    idleTimeout = 1.5.min
    maxRequestSize = 10.mib
  }
}

greeting {
  message = "Hello from \(micronaut.application.name)"
  ratio = 0.5
  enabled = true
  tags = new Listing { "a"; "b" }
  hosts = new Mapping { ["primary"] = "x"; ["secondary"] = "y" }
  endpoints = new Listing {
    new Dynamic { path = "/one"; weight = 1 }
  }
  placeholder = "${GREETING_FROM_ENV:fallback}"
}
