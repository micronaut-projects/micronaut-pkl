/// Production configuration. Declared `open` so that environment-specific modules such as
/// `application-test.pkl` in `src/test/resources` can extend it: override values, refer to them
/// through `super`, and add keys the production module does not define.
open module application

micronaut {
  application { name = "pkl-graal" }
  server {
    port = -1
    idleTimeout = 30.s
    maxRequestSize = 10.mib
  }
}

greeting {
  message = "Hello from \(micronaut.application.name)"
  retries = 3
  timeout = 1.5.min
  tags = new Listing { "native"; "pkl" }
  hosts = new Mapping { ["primary"] = "a"; ["secondary"] = "b" }
  fromEnv = read?("env:PKL_GRAAL_GREETING") ?? "unset"
}
